#!/bin/sh
# GoshaCrash 1.2.0-local — local-only installer/runtime for ASUS RT-AC68U.
# One persistent Mihomo configuration: config.yaml.

VERSION="1.2.0-local"
BUILD_ID="2026-07-26-local-config-only"

SCRIPT_DIR="$(CDPATH= cd "$(dirname "$0")" 2>/dev/null && pwd)"
BASE="${GOSHACRASH_BASE:-$SCRIPT_DIR}"
USB_MOUNT="$(dirname "$BASE")"
BIN="$BASE/bin/mihomo"
UI="$BASE/ui"
CONFIG="$BASE/config.yaml"
ROUTE_HELPER="$BASE/goshacrash-route"
RUN="$BASE/run"
LOGS="$BASE/logs"
STATE="$BASE/state"
PIDFILE="$RUN/mihomo.pid"
LOGFILE="$LOGS/mihomo.log"
BOOT_PIDFILE="$RUN/boot.pid"
START_LOCK="$RUN/start.lock"
JFFS_DIR="/jffs/addons/goshacrash"
JFFS_BASE_FILE="$JFFS_DIR/base"

TUN_DEVICE="tun0"
TUN_TABLE="${GOSHACRASH_TUN_TABLE:-2022}"
TUN_RULE_PREF="${GOSHACRASH_TUN_RULE_PREF:-10010}"
TUN_MARK="${GOSHACRASH_TUN_MARK:-0x2333}"
OUTBOUND_MARK_DEC="${GOSHACRASH_OUTBOUND_MARK_DEC:-9012}"
OUTBOUND_MARK_HEX="${GOSHACRASH_OUTBOUND_MARK:-0x2334}"
DNS_PORT="${MIHOMO_DNS_PORT:-1053}"
ROUTE_ROUTER="${GOSHACRASH_ROUTE_ROUTER:-1}"
BOOT_WAIT="${GOSHACRASH_BOOT_WAIT:-300}"

PATH="/usr/sbin:/usr/bin:/sbin:/bin:/opt/bin:/opt/sbin:$PATH"
export PATH

say(){ printf '%s\n' "[GoshaCrash] $*"; }
warn(){ printf '%s\n' "[GoshaCrash:WARN] $*" >&2; }
fail(){ printf '%s\n' "[GoshaCrash:ERROR] $*" >&2; return 1; }
have(){ command -v "$1" >/dev/null 2>&1; }
ensure_dirs(){ mkdir -p "$BASE/bin" "$UI" "$RUN" "$LOGS" "$STATE"; }
lan_ip(){ x="$(nvram get lan_ipaddr 2>/dev/null)"; [ -n "$x" ] || x=192.168.1.1; printf '%s\n' "$x"; }
lan_ifaces(){ x="$(nvram get lan_ifname 2>/dev/null)"; [ -n "$x" ] || x=br0; printf '%s\n' "$x"; }

strip_value(){
    printf '%s\n' "$1" | sed 's/[[:space:]]*#.*$//; s/^[[:space:]]*//; s/[[:space:]]*$//; s/^"//; s/"$//; s/^'"'"'//; s/'"'"'$//'
}

yaml_top(){
    key="$2"
    awk -v key="$key" '
      { sub(/\r$/, "") }
      $0 ~ "^" key ":[[:space:]]*" {
        line=$0; sub("^" key ":[[:space:]]*", "", line); print line; exit
      }
    ' "$1" 2>/dev/null | while IFS= read -r line; do strip_value "$line"; done
}

yaml_section(){
    file="$1"; section="$2"; key="$3"
    awk -v section="$section" -v key="$key" '
      { sub(/\r$/, "") }
      $0 ~ "^" section ":[[:space:]]*($|#)" { inside=1; next }
      inside && /^[^[:space:]#]/ { exit }
      inside && $0 ~ "^[[:space:]]+" key ":[[:space:]]*" {
        line=$0; sub("^[[:space:]]+" key ":[[:space:]]*", "", line); print line; exit
      }
    ' "$file" 2>/dev/null | while IFS= read -r line; do strip_value "$line"; done
}

is_true(){ case "$1" in true|True|TRUE|yes|Yes|YES|1|on|On|ON) return 0;; *) return 1;; esac; }
is_false(){ case "$1" in false|False|FALSE|no|No|NO|0|off|Off|OFF) return 0;; *) return 1;; esac; }

running_pid(){
    [ -f "$PIDFILE" ] || return 1
    p="$(cat "$PIDFILE" 2>/dev/null)"
    case "$p" in ''|*[!0-9]*) return 1;; esac
    kill -0 "$p" 2>/dev/null || { rm -f "$PIDFILE"; return 1; }
    if [ -r "/proc/$p/cmdline" ]; then
        tr '\000' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q "$BIN" || return 1
    fi
    printf '%s\n' "$p"
}

kill_mihomo(){
    if p="$(running_pid)"; then
        kill "$p" 2>/dev/null || true
        n=0
        while kill -0 "$p" 2>/dev/null && [ "$n" -lt 10 ]; do sleep 1; n=$((n+1)); done
        kill -0 "$p" 2>/dev/null && kill -9 "$p" 2>/dev/null || true
    fi
    for p in $(pidof mihomo 2>/dev/null); do
        kill "$p" 2>/dev/null || true
    done
    rm -f "$PIDFILE"
}

ensure_tun(){
    [ -c /dev/net/tun ] || {
        modprobe tun >/dev/null 2>&1 || true
        for m in \
          "$BASE/modules/tun.ko" \
          "/lib/modules/$(uname -r)/kernel/drivers/net/tun.ko" \
          "/lib/modules/$(uname -r)/tun.ko"; do
            [ -c /dev/net/tun ] && break
            [ -f "$m" ] && insmod "$m" >/dev/null 2>&1 || true
        done
    }
    if [ ! -c /dev/net/tun ]; then
        mkdir -p /dev/net 2>/dev/null || true
        mknod /dev/net/tun c 10 200 2>/dev/null || true
        chmod 600 /dev/net/tun 2>/dev/null || true
    fi
    [ -c /dev/net/tun ] || return 1
    dd if=/dev/net/tun of=/dev/null bs=1 count=0 >/dev/null 2>&1
}

required_config(){
    [ -f "$CONFIG" ] || { fail "Не найден $CONFIG"; return 1; }

    is_true "$(yaml_section "$CONFIG" tun enable)" || { fail "config.yaml: tun.enable должен быть true"; return 1; }
    [ "$(yaml_section "$CONFIG" tun stack)" = "gvisor" ] || { fail "config.yaml: tun.stack должен быть gvisor"; return 1; }
    [ "$(yaml_section "$CONFIG" tun device)" = "$TUN_DEVICE" ] || { fail "config.yaml: tun.device должен быть $TUN_DEVICE"; return 1; }
    is_false "$(yaml_section "$CONFIG" tun auto-route)" || { fail "config.yaml: tun.auto-route должен быть false"; return 1; }
    is_false "$(yaml_section "$CONFIG" tun auto-redirect)" || { fail "config.yaml: tun.auto-redirect должен быть false"; return 1; }

    is_true "$(yaml_section "$CONFIG" dns enable)" || { fail "config.yaml: dns.enable должен быть true"; return 1; }
    [ "$(yaml_section "$CONFIG" dns listen)" = "127.0.0.1:$DNS_PORT" ] || { fail "config.yaml: dns.listen должен быть 127.0.0.1:$DNS_PORT"; return 1; }

    [ "$(yaml_top "$CONFIG" routing-mark)" = "$OUTBOUND_MARK_DEC" ] || { fail "config.yaml: routing-mark должен быть $OUTBOUND_MARK_DEC"; return 1; }
    is_false "$(yaml_top "$CONFIG" ipv6)" || { fail "config.yaml: ipv6 должен быть false"; return 1; }
    return 0
}

validate_binary(){
    [ -x "$BIN" ] || { fail "Не найден исполняемый $BIN"; return 1; }
    out="$($BIN -v 2>&1)" || { printf '%s\n' "$out" >&2; fail "Mihomo не запускается"; return 1; }
    printf '%s\n' "$out" | grep -Fq 'Use tags: with_gvisor' || { printf '%s\n' "$out" >&2; fail "Mihomo собран без with_gvisor"; return 1; }
    printf '%s\n' "$out" | grep -qi 'linux arm' || { printf '%s\n' "$out" >&2; fail "Mihomo не является Linux ARM-сборкой"; return 1; }
}

check_config(){
    ensure_dirs || return 1
    validate_binary || return 1
    required_config || return 1
    "$BIN" -t -d "$BASE" -f "$CONFIG"
}

wait_port(){
    p="$1"; n=0
    while [ "$n" -lt 20 ]; do
        netstat -ln 2>/dev/null | grep -Eq "[:.]$p[[:space:]]" && return 0
        sleep 1; n=$((n+1))
    done
    return 1
}

wait_tun(){
    n=0
    while [ "$n" -lt 20 ]; do
        ip link show "$TUN_DEVICE" >/dev/null 2>&1 && return 0
        ifconfig "$TUN_DEVICE" >/dev/null 2>&1 && return 0
        sleep 1; n=$((n+1))
    done
    return 1
}

route(){
    [ -x "$ROUTE_HELPER" ] || { fail "Не найден $ROUTE_HELPER"; return 1; }
    GOSHACRASH_BASE="$BASE" \
    GOSHACRASH_TUN_DEVICE="$TUN_DEVICE" \
    GOSHACRASH_TUN_TABLE="$TUN_TABLE" \
    GOSHACRASH_TUN_RULE_PREF="$TUN_RULE_PREF" \
    GOSHACRASH_TUN_MARK="$TUN_MARK" \
    GOSHACRASH_OUTBOUND_MARK="$OUTBOUND_MARK_HEX" \
    GOSHACRASH_ROUTE_ROUTER="$ROUTE_ROUTER" \
    MIHOMO_DNS_PORT="$DNS_PORT" \
      "$ROUTE_HELPER" "$1"
}

start_inner(){
    ensure_dirs || return 1
    check_config || return 1
    ensure_tun || { fail "Драйвер /dev/net/tun недоступен"; return 1; }

    if p="$(running_pid)"; then
        route reload || return 1
        say "Mihomo уже работает, PID=$p"
        return 0
    fi

    route stop >/dev/null 2>&1 || true
    kill_mihomo
    [ -f "$LOGFILE" ] && [ "$(wc -c < "$LOGFILE" 2>/dev/null)" -gt 1048576 ] 2>/dev/null && mv -f "$LOGFILE" "$LOGFILE.previous"

    if have nohup; then
        GOGC="${GOGC:-50}" nohup "$BIN" -d "$BASE" -f "$CONFIG" </dev/null >>"$LOGFILE" 2>&1 &
    else
        GOGC="${GOGC:-50}" "$BIN" -d "$BASE" -f "$CONFIG" </dev/null >>"$LOGFILE" 2>&1 &
    fi
    p=$!
    printf '%s\n' "$p" > "$PIDFILE"
    sleep 2

    running_pid >/dev/null 2>&1 || { tail -n 80 "$LOGFILE" >&2; fail "Mihomo завершился при запуске"; return 1; }
    wait_port "$DNS_PORT" || { kill_mihomo; tail -n 80 "$LOGFILE" >&2; fail "Mihomo DNS не слушает $DNS_PORT"; return 1; }
    wait_tun || { kill_mihomo; tail -n 80 "$LOGFILE" >&2; fail "Mihomo не создал $TUN_DEVICE"; return 1; }
    route start || { kill_mihomo; route stop >/dev/null 2>&1 || true; fail "Маршрутизация не поднялась; оставлен DIRECT"; return 1; }

    say "Mihomo запущен, PID=$p"
    say "LAN и трафик роутера: mark $TUN_MARK -> table $TUN_TABLE -> $TUN_DEVICE"
}

start(){
    ensure_dirs || return 1
    if ! mkdir "$START_LOCK" 2>/dev/null; then
        n=0
        while [ -d "$START_LOCK" ] && [ "$n" -lt 20 ]; do sleep 1; n=$((n+1)); done
        [ -d "$START_LOCK" ] && { fail "Другой запуск GoshaCrash не завершился"; return 1; }
        mkdir "$START_LOCK" 2>/dev/null || return 1
    fi
    start_inner
    rc=$?
    rmdir "$START_LOCK" 2>/dev/null || true
    return "$rc"
}

stop(){
    route stop >/dev/null 2>&1 || true
    kill_mihomo
    rm -rf "$START_LOCK" 2>/dev/null || true
    rm -f "$BOOT_PIDFILE" 2>/dev/null || true
    say "Mihomo остановлен; правила удалены, обычный DIRECT восстановлен"
}

restart(){ stop >/dev/null 2>&1 || true; start; }

main_default_route(){ ip route show table main 2>/dev/null | grep -q '^default '; }

boot(){
    ensure_dirs || return 1
    if [ -f "$BOOT_PIDFILE" ]; then
        old="$(cat "$BOOT_PIDFILE" 2>/dev/null)"
        case "$old" in ''|*[!0-9]*) old="";; esac
        [ -n "$old" ] && kill -0 "$old" 2>/dev/null && { say "Автозапуск уже выполняется, PID=$old"; return 0; }
    fi
    echo "$$" > "$BOOT_PIDFILE"
    waited=0
    while ! main_default_route; do
        [ "$waited" -ge "$BOOT_WAIT" ] && { warn "Default route не появился за $BOOT_WAIT секунд; оставлен DIRECT"; rm -f "$BOOT_PIDFILE"; return 0; }
        sleep 5; waited=$((waited+5))
    done
    sleep 5
    start
    rc=$?
    rm -f "$BOOT_PIDFILE"
    return "$rc"
}

firewall_reload(){
    running_pid >/dev/null 2>&1 || return 0
    route reload || { warn "Не удалось восстановить правила после перезапуска firewall"; stop; return 1; }
}

add_once(){
    file="$1"; line="$2"
    [ -f "$file" ] || printf '#!/bin/sh\n' > "$file"
    grep -Fqx "$line" "$file" 2>/dev/null || printf '%s\n' "$line" >> "$file"
    chmod 755 "$file"
}

install_hooks(){
    ensure_dirs || return 1
    mkdir -p "$JFFS_DIR" /jffs/scripts || return 1
    printf '%s\n' "$BASE" > "$JFFS_BASE_FILE" || return 1

    cat > /jffs/scripts/goshacrash-start <<'HOOK'
#!/bin/sh
BASE_FILE=/jffs/addons/goshacrash/base
BASE="$(cat "$BASE_FILE" 2>/dev/null)"
[ -x "$BASE/goshacrash" ] || exit 0
mkdir -p "$BASE/run" "$BASE/logs" 2>/dev/null || true
if command -v nohup >/dev/null 2>&1; then
  GOSHACRASH_BASE="$BASE" nohup "$BASE/goshacrash" boot </dev/null >>"$BASE/logs/boot.log" 2>&1 &
else
  GOSHACRASH_BASE="$BASE" "$BASE/goshacrash" boot </dev/null >>"$BASE/logs/boot.log" 2>&1 &
fi
HOOK
    chmod 755 /jffs/scripts/goshacrash-start || return 1

    cat > /jffs/scripts/goshacrash-firewall <<'HOOK'
#!/bin/sh
BASE="$(cat /jffs/addons/goshacrash/base 2>/dev/null)"
[ -x "$BASE/goshacrash" ] && GOSHACRASH_BASE="$BASE" "$BASE/goshacrash" firewall-reload >/dev/null 2>&1
HOOK
    chmod 755 /jffs/scripts/goshacrash-firewall || return 1

    add_once /jffs/scripts/services-start '/jffs/scripts/goshacrash-start &'
    add_once /jffs/scripts/firewall-start '/jffs/scripts/goshacrash-firewall &'

    opt="$USB_MOUNT/asusware.arm"
    if [ -d "$opt" ]; then
        mkdir -p "$opt/bin" "$opt/etc/init.d" || return 1
        cat > "$opt/bin/goshacrash" <<WRAP
#!/bin/sh
BASE="\$(cat "$JFFS_BASE_FILE" 2>/dev/null)"
exec "\$BASE/goshacrash" "\$@"
WRAP
        chmod 755 "$opt/bin/goshacrash"
        ln -sf "$opt/bin/goshacrash" /opt/bin/goshacrash 2>/dev/null || true

        cat > "$opt/etc/init.d/S99goshacrash" <<'INIT'
#!/bin/sh
case "$1" in
  start) /jffs/scripts/goshacrash-start & ;;
  stop) BASE="$(cat /jffs/addons/goshacrash/base 2>/dev/null)"; [ -x "$BASE/goshacrash" ] && GOSHACRASH_BASE="$BASE" "$BASE/goshacrash" stop ;;
  restart) BASE="$(cat /jffs/addons/goshacrash/base 2>/dev/null)"; [ -x "$BASE/goshacrash" ] && GOSHACRASH_BASE="$BASE" "$BASE/goshacrash" restart ;;
  firewall-start|firewall-restart) /jffs/scripts/goshacrash-firewall & ;;
esac
INIT
        chmod 755 "$opt/etc/init.d/S99goshacrash"
    fi

    say "Автозапуск установлен"
}

status(){
    if p="$(running_pid)"; then echo "Mihomo: работает, PID=$p"; else echo "Mihomo: не запущен"; fi
    echo "GoshaCrash: $VERSION"
    echo "BASE: $BASE"
    echo "Config: $CONFIG"
    if ip link show "$TUN_DEVICE" >/dev/null 2>&1 || ifconfig "$TUN_DEVICE" >/dev/null 2>&1; then echo "TUN: $TUN_DEVICE работает"; else echo "TUN: $TUN_DEVICE не найден"; fi
    if running_pid >/dev/null 2>&1 && route status >/dev/null 2>&1; then echo "Маршрутизация: работает"; else echo "Маршрутизация: выключена или неполна"; fi
    c="$(yaml_top "$CONFIG" external-controller)"; [ -n "$c" ] || c=0.0.0.0:9090
    p="${c##*:}"; case "$p" in ''|*[!0-9]*) p=9090;; esac
    echo "Zashboard: http://$(lan_ip):$p/ui/"
    s="$(yaml_top "$CONFIG" secret)"; [ -n "$s" ] && echo "API secret: $s"
}

doctor(){
    echo '=== files ==='
    ls -l "$BIN" "$CONFIG" "$ROUTE_HELPER" 2>/dev/null || true
    [ -f "$UI/index.html" ] && echo 'Zashboard: OK' || echo 'Zashboard: MISSING'
    echo '=== binary ==='
    "$BIN" -v 2>&1 || true
    echo '=== config ==='
    check_config || true
    echo '=== tun ==='
    ensure_tun && echo '/dev/net/tun: OK' || echo '/dev/net/tun: ERROR'
    echo '=== status ==='
    status
    echo '=== route ==='
    route doctor || true
    echo '=== log ==='
    tail -n 100 "$LOGFILE" 2>/dev/null || true
}

update_local(){
    pkg="${2:-$USB_MOUNT/GoshaCrash-update}"
    [ -d "$pkg" ] || { fail "Локальный пакет обновления не найден: $pkg"; return 1; }
    [ -x "$pkg/bin/mihomo" ] || { fail "В обновлении нет bin/mihomo"; return 1; }
    [ -f "$pkg/ui/index.html" ] || { fail "В обновлении нет ui/index.html"; return 1; }
    [ -f "$pkg/goshacrash" ] || { fail "В обновлении нет goshacrash"; return 1; }
    [ -f "$pkg/goshacrash-route" ] || { fail "В обновлении нет goshacrash-route"; return 1; }
    sh -n "$pkg/goshacrash" || { fail "Некорректный goshacrash в обновлении"; return 1; }
    sh -n "$pkg/goshacrash-route" || { fail "Некорректный goshacrash-route в обновлении"; return 1; }
    out="$($pkg/bin/mihomo -v 2>&1)" || { fail "Новый Mihomo не запускается"; return 1; }
    printf '%s\n' "$out" | grep -Fq 'Use tags: with_gvisor' || { fail "Новый Mihomo без with_gvisor"; return 1; }
    printf '%s\n' "$out" | grep -qi 'linux arm' || { fail "Новый Mihomo не является Linux ARM-сборкой"; return 1; }

    backup="$BASE/update-backup-$(date +%Y%m%d-%H%M%S 2>/dev/null)"
    mkdir -p "$backup" || return 1
    cp "$BASE/goshacrash" "$backup/goshacrash" || return 1
    cp "$BASE/goshacrash-route" "$backup/goshacrash-route" || return 1
    cp "$BIN" "$backup/mihomo" || return 1
    [ -d "$UI" ] && cp -R "$UI" "$backup/ui" 2>/dev/null || true

    restore_update(){
        stop >/dev/null 2>&1 || true
        cp "$backup/goshacrash" "$BASE/goshacrash" 2>/dev/null || true
        cp "$backup/goshacrash-route" "$BASE/goshacrash-route" 2>/dev/null || true
        cp "$backup/mihomo" "$BIN" 2>/dev/null || true
        if [ -d "$backup/ui" ]; then rm -rf "$UI"; cp -R "$backup/ui" "$UI" 2>/dev/null || true; fi
        chmod 755 "$BASE/goshacrash" "$BASE/goshacrash-route" "$BIN" 2>/dev/null || true
        GOSHACRASH_BASE="$BASE" "$BASE/goshacrash" install-hooks >/dev/null 2>&1 || true
        GOSHACRASH_BASE="$BASE" "$BASE/goshacrash" start >/dev/null 2>&1 || true
    }

    stop >/dev/null 2>&1 || true
    cp "$pkg/goshacrash" "$BASE/goshacrash.new" || { restore_update; return 1; }
    cp "$pkg/goshacrash-route" "$BASE/goshacrash-route.new" || { restore_update; return 1; }
    cp "$pkg/bin/mihomo" "$BASE/bin/mihomo.new" || { restore_update; return 1; }
    rm -rf "$BASE/ui.new"; cp -R "$pkg/ui" "$BASE/ui.new" || { restore_update; return 1; }
    chmod 755 "$BASE/goshacrash.new" "$BASE/goshacrash-route.new" "$BASE/bin/mihomo.new"
    mv -f "$BASE/goshacrash.new" "$BASE/goshacrash"
    mv -f "$BASE/goshacrash-route.new" "$BASE/goshacrash-route"
    mv -f "$BASE/bin/mihomo.new" "$BIN"
    rm -rf "$UI"; mv "$BASE/ui.new" "$UI"

    GOSHACRASH_BASE="$BASE" "$BASE/goshacrash" check || { warn "Новая версия не прошла проверку; возвращаю старую"; restore_update; return 1; }
    GOSHACRASH_BASE="$BASE" "$BASE/goshacrash" install-hooks || { restore_update; return 1; }
    GOSHACRASH_BASE="$BASE" "$BASE/goshacrash" start || { warn "Новая версия не запустилась; возвращаю старую"; restore_update; return 1; }
    say "Локальное обновление завершено"
}

menu(){
    while :; do
        echo '========================================'
        echo "          GoshaCrash $VERSION"
        echo '========================================'
        echo '1) Перезапустить'
        echo '2) Обновить всё из локального пакета'
        echo '0) Выход'
        printf 'Выбери пункт: '
        read choice
        case "$choice" in
            1) restart;;
            2) update_local update-local;;
            0) return 0;;
            *) echo 'Неизвестный пункт';;
        esac
    done
}

usage(){
    cat <<USAGE
GoshaCrash $VERSION

  goshacrash              минимальное меню
  goshacrash start        запустить Mihomo и маршрутизацию
  goshacrash stop         остановить и вернуть DIRECT
  goshacrash restart      перезапустить
  goshacrash status       состояние
  goshacrash check        проверить config.yaml
  goshacrash doctor       полная диагностика
  goshacrash logs [N]     последние N строк лога
  goshacrash install-hooks установить автозапуск
  goshacrash update-local [КАТАЛОГ] обновить из локального пакета
USAGE
}

ensure_dirs >/dev/null 2>&1 || true
case "${1:-menu}" in
    menu) menu;;
    start) start;;
    stop|direct) stop;;
    restart) restart;;
    status) status;;
    check) check_config;;
    doctor) doctor;;
    logs) tail -n "${2:-100}" "$LOGFILE" 2>/dev/null || true;;
    boot) boot;;
    firewall-reload) firewall_reload;;
    install-hooks) install_hooks;;
    update-local) update_local "$@";;
    version) echo "$VERSION";;
    help|-h|--help) usage;;
    *) usage; exit 1;;
esac
